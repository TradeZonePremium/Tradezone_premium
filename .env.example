# Copy this file to ".env.local" and fill in your real values.
# NEVER commit .env.local and NEVER paste these values in chat/screenshots.

# ---------- Site ----------
# Local: http://localhost:3000   |   Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Supabase (Project Settings -> API) ----------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# SERVER ONLY - never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------- Razorpay (Dashboard -> Account & Settings -> API Keys) ----------
# Key ID is public (used by Checkout). Use rzp_test_... while testing.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxx
# SERVER ONLY
RAZORPAY_KEY_SECRET=xxxxx
# The secret you type when creating the webhook in Razorpay dashboard
RAZORPAY_WEBHOOK_SECRET=choose-a-long-random-string

# ---------- Email (Resend) ----------
RESEND_API_KEY=re_xxxxx
# Must be an address on a domain you verified in Resend.
# For quick testing only, "Trade Zone Premium <onboarding@resend.dev>" works
# but it can only deliver to your own Resend account email.
EMAIL_FROM=Trade Zone Premium <noreply@your-domain.com>

# ---------- WhatsApp ----------
# Real invite link. Customers never see this; they use /join?token=...
WHATSAPP_INVITE_URL=https://chat.whatsapp.com/xxxxxxxxxxxx

# ---------- Admin ----------
# Comma-separated emails allowed to open /admin
ADMIN_EMAILS=rohan@example.com

# ---------- Cron ----------
# Random string. Vercel sends it automatically as "Authorization: Bearer <value>"
CRON_SECRET=another-long-random-string
